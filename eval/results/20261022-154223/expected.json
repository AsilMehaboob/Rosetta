  "q5": {
    "sql": "SELECT f.SNAPSHOT_DT, h.ESIM_IND, COUNT(f.SUBSCRIPTION_ID) AS SUBSCRIBER_COUNT\nFROM VID.F_SUBSCRIPTION_D f\nJOIN VID.D_STATUS s ON s.STATUS_ID = f.STATUS_ID\nLEFT JOIN VID.D_ICCI_IMSI_SUBS_HIST h\n  ON h.SUBSCRIPTION_ID = f.SUBSCRIPTION_ID\n AND TRUNC(h.ICCI_IMSI_SUBS_SDT) <= f.SNAPSHOT_DT\n AND h.ICCI_IMSI_SUBS_EDT > f.SNAPSHOT_DT + INTERVAL '23:59:59' HOUR TO SECOND\nWHERE f.SNAPSHOT_DT = DATE '2026-08-28'\n  AND s.VFTR_BASE_IND = 'Y'\n  AND f.MAIN_OFFER_ID <> '1-IFF31UQ'\nGROUP BY f.SNAPSHOT_DT, h.ESIM_IND\nORDER BY h.ESIM_IND\n",
    "columns": [
      "SNAPSHOT_DT",
      "ESIM_IND",
      "SUBSCRIBER_COUNT"
    ],
    "rows": [
