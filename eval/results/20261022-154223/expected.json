  "q4": {
    "sql": "SELECT EVENT_MONTH, GROSS_ADDS, DISCONNECTIONS,\n       GROSS_ADDS - LAG(GROSS_ADDS) OVER (ORDER BY EVENT_MONTH) AS GROSS_ADD_CHANGE,\n       DISCONNECTIONS - LAG(DISCONNECTIONS) OVER (ORDER BY EVENT_MONTH) AS DISCONNECTION_CHANGE\nFROM (\n  SELECT TRUNC(EVENT_DT, 'MM') AS EVENT_MONTH,\n         SUM(CASE WHEN LIFECYCLE_GROUP_CD = 'grossadd' THEN 1 ELSE 0 END) AS GROSS_ADDS,\n         SUM(CASE WHEN LIFECYCLE_GROUP_CD = 'disconnection' THEN 1 ELSE 0 END) AS DISCONNECTIONS\n  FROM VID.F_LIFECYCLE_KPI\n  WHERE EVENT_DT >= DATE '2026-07-01' AND EVENT_DT < DATE '2026-09-01'\n  GROUP BY TRUNC(EVENT_DT, 'MM')\n)\nORDER BY EVENT_MONTH\n",
    "columns": [
      "EVENT_MONTH",
      "GROSS_ADDS",
      "DISCONNECTIONS",
      "GROSS_ADD_CHANGE",
      "DISCONNECTION_CHANGE"
    ],
