  "q6": {
    "sql": "SELECT t.TARIFF_NAME, COUNT(*) AS DISCONNECTIONS\nFROM VID.F_LIFECYCLE_KPI k\nJOIN VID.D_SUBS_TARIFF_HIST th\n  ON th.SUBSCRIPTION_ID = k.SUBSCRIPTION_ID\n AND k.EVENT_DT >= th.SUBS_OFFER_SDT\n AND k.EVENT_DT <  th.SUBS_OFFER_EDT\nJOIN VID.D_TARIFF t ON t.OFFER_ID = th.OFFER_ID\nWHERE k.LIFECYCLE_GROUP_CD = 'disconnection'\n  AND k.EVENT_DT >= DATE '2026-08-01' AND k.EVENT_DT < DATE '2026-09-01'\nGROUP BY t.TARIFF_NAME\nORDER BY DISCONNECTIONS DESC\n",
    "columns": [
      "TARIFF_NAME",
      "DISCONNECTIONS"
