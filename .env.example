# Source database (read-only login)
SOURCE_DIALECT=oracle
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=
ORACLE_USER=
ORACLE_PASSWORD=
# comma-separated schemas to learn
SOURCE_SCHEMAS=

# LLM
GEMINI_API_KEY=
# a fixed version, not a -latest alias, so answers stay the same between runs
GEMINI_MODEL=gemini-3.5-flash-lite

# "today" for relative dates such as "last month" (YYYY-MM-DD); empty means the real today
REFERENCE_DATE=

# Query limits
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_ROWS=1000

# Where learned artifacts are stored (git-ignored)
DATA_DIR=data

# Browser addresses allowed to call the API (the UI), comma-separated
CORS_ORIGINS=http://localhost:5173
